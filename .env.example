# Copy to .env and fill in your secrets:
#   cp .env.example .env
#
# .env is gitignored and will NOT be pushed to GitHub.
# When switching computers, copy .env securely (USB / password manager).

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
LOG_LEVEL=INFO

