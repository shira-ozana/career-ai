# Copy to .env and fill in your secrets:
#   cp .env.example .env
#
# .env is gitignored and will NOT be pushed to GitHub.
# When switching computers, copy .env securely (USB / password manager).

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Cursor (optional LLM provider for: career-ai extract-profile --provider cursor)
# User API key from Cursor Dashboard -> Integrations. Never commit a real key.
CURSOR_API_KEY=
# Documented cursor-sdk quick-start model. Local runs require a model id.
CURSOR_MODEL=composer-2.5

LOG_LEVEL=INFO

# PostgreSQL (SQLAlchemy URL). Use the psycopg3 driver prefix.
# Replace user, password, host, and database — do not commit a real URL.
DATABASE_URL=postgresql+psycopg://user:password@host:5432/postgres

# GitHub (personal account – used for git push helpers)
GITHUB_USERNAME=shira-ozana
GITHUB_TOKEN=ghp_your_token_here
